# Django settings
DEBUG=True
SECRET_KEY=your-secret-key-here

# Database
DATABASE_URL=postgres://precogly:precogly_dev_password@localhost:5432/precogly

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Library packs (optional; defaults to <repo root>/libraries, which holds the
# three demo packs bundled with the app: STRIDE, a subset of OWASP ASVS and a
# small AWS pack)
# LIBRARIES_PATH=/app/libraries

# The pack catalog listing the full packs from precogly/library-packs (optional).
# The default follows the latest release. Set one release to freeze the packs,
# your own copy for an offline site, or nothing to turn the catalog off.
# PACK_CATALOG_URL=https://github.com/precogly/library-packs/releases/download/v2026.11.26.1/catalog.json
# PACK_CATALOG_URL=
# Largest pack archive the app downloads, in bytes (default 20 MB)
# PACK_DOWNLOAD_MAX_BYTES=20971520
