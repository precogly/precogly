# The backend image builds from the repository root (backend/Dockerfile explains
# why), so this file governs what is sent to the daemon. The Dockerfile copies
# only pyproject.toml, uv.lock, backend/, mcp/ and libraries/ — everything else
# here is transfer cost rather than correctness, and node_modules is most of it.
#
# libraries/ is deliberately not listed: it is the pack sources the image seeds
# from, and ignoring it again would fail the build rather than quietly ship an
# image whose library catalogs come up empty.
.git/
frontend/
docs/
site/

# Patterns match from the context root only, so the ones that can appear inside
# backend/ or mcp/ need the **/ prefix. backend/venv/ alone is several hundred MB.
**/venv/
# uv's default location. A host venv holds host-platform wheels.
**/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/.env
**/.env.*
**/*.egg-info/
**/.mypy_cache/
**/.pytest_cache/
**/.ruff_cache/
**/htmlcov/
**/.coverage
backend/staticfiles/
backend/media/
